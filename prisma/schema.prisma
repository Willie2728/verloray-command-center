generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model User { id String @id @default(cuid()); email String @unique; name String?; organizationId String?; organization Organization? @relation(fields:[organizationId],references:[id]); projects Project[]; preferences UserPreference[]; auditEvents AuditEvent[]; createdAt DateTime @default(now()) }
model Organization { id String @id @default(cuid()); name String; users User[]; projects Project[]; guides Guide[]; createdAt DateTime @default(now()) }
model Project { id String @id @default(cuid()); name String; organizationId String?; organization Organization? @relation(fields:[organizationId],references:[id]); ownerId String; owner User @relation(fields:[ownerId],references:[id]); conversations Conversation[]; tasks Task[]; files FileAsset[]; memories MemoryRecord[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Conversation { id String @id @default(cuid()); projectId String; project Project @relation(fields:[projectId],references:[id],onDelete:Cascade); title String; messages Message[]; providerRuns ProviderRun[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Message { id String @id @default(cuid()); conversationId String; conversation Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade); role String; content Json; providerRunId String?; createdAt DateTime @default(now()) }
model Provider { id String @id; displayName String; capabilityConfig Json; credentialRefs ProviderCredentialReference[]; modelConfigurations ModelConfiguration[]; providerRuns ProviderRun[]; usageRecords UsageRecord[]; costRecords CostRecord[] }
model ProviderCredentialReference { id String @id @default(cuid()); providerId String; provider Provider @relation(fields:[providerId],references:[id]); ownerId String; vaultReference String; status String; createdAt DateTime @default(now()) }
model ModelConfiguration { id String @id @default(cuid()); providerId String; provider Provider @relation(fields:[providerId],references:[id]); modelId String; configuration Json; active Boolean @default(true) }
model Guide { id String @id @default(cuid()); organizationId String?; organization Organization? @relation(fields:[organizationId],references:[id]); name String; role String; description String; instructions String; configuration Json; active Boolean @default(true); assignments GuideAssignment[] }
model GuideAssignment { id String @id @default(cuid()); guideId String; guide Guide @relation(fields:[guideId],references:[id]); taskId String; task Task @relation(fields:[taskId],references:[id]); createdAt DateTime @default(now()) }
model Task { id String @id @default(cuid()); projectId String; project Project @relation(fields:[projectId],references:[id]); title String; status String; parentTaskId String?; parent Task? @relation("TaskTree",fields:[parentTaskId],references:[id]); children Task[] @relation("TaskTree"); assignments GuideAssignment[]; dependencies TaskDependency[] @relation("Dependent"); requiredBy TaskDependency[] @relation("Dependency"); providerRuns ProviderRun[]; createdAt DateTime @default(now()) }
model TaskDependency { id String @id @default(cuid()); taskId String; task Task @relation("Dependent",fields:[taskId],references:[id]); dependsOnId String; dependsOn Task @relation("Dependency",fields:[dependsOnId],references:[id]) }
model ProviderRun { id String @id @default(cuid()); providerId String; provider Provider @relation(fields:[providerId],references:[id]); conversationId String?; conversation Conversation? @relation(fields:[conversationId],references:[id]); taskId String?; task Task? @relation(fields:[taskId],references:[id]); status String; requestMetadata Json; responseMetadata Json?; artifacts ResponseArtifact[]; citations Citation[]; usageRecords UsageRecord[]; costRecords CostRecord[]; createdAt DateTime @default(now()) }
model ResponseArtifact { id String @id @default(cuid()); providerRunId String; providerRun ProviderRun @relation(fields:[providerRunId],references:[id]); kind String; content Json; createdAt DateTime @default(now()) }
model Citation { id String @id @default(cuid()); providerRunId String; providerRun ProviderRun @relation(fields:[providerRunId],references:[id]); url String?; title String?; excerpt String?; metadata Json? }
model FileAsset { id String @id @default(cuid()); projectId String; project Project @relation(fields:[projectId],references:[id]); name String; mimeType String; size Int; storageReference String; createdAt DateTime @default(now()) }
model MemoryRecord { id String @id @default(cuid()); projectId String?; project Project? @relation(fields:[projectId],references:[id]); scope String; content Json; sourceAttribution Json; pinned Boolean @default(false); archived Boolean @default(false); createdAt DateTime @default(now()); lastUsedAt DateTime? }
model Workflow { id String @id @default(cuid()); name String; definition Json; runs WorkflowRun[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model WorkflowRun { id String @id @default(cuid()); workflowId String; workflow Workflow @relation(fields:[workflowId],references:[id]); status String; input Json; output Json?; createdAt DateTime @default(now()) }
model ApprovalRequest { id String @id @default(cuid()); category String; requestedBy String; providerId String?; action Json; risk Json; status String; decidedAt DateTime?; createdAt DateTime @default(now()) }
model UsageRecord { id String @id @default(cuid()); providerId String; provider Provider @relation(fields:[providerId],references:[id]); providerRunId String?; providerRun ProviderRun? @relation(fields:[providerRunId],references:[id]); inputTokens Int?; outputTokens Int?; latencyMs Int?; createdAt DateTime @default(now()) }
model CostRecord { id String @id @default(cuid()); providerId String; provider Provider @relation(fields:[providerId],references:[id]); providerRunId String?; providerRun ProviderRun? @relation(fields:[providerRunId],references:[id]); estimatedAmount Decimal; currency String; pricingVersion String; createdAt DateTime @default(now()) }
model AuditEvent { id String @id @default(cuid()); userId String?; user User? @relation(fields:[userId],references:[id]); action String; target String; metadata Json; createdAt DateTime @default(now()) }
model AvatarConfiguration { id String @id @default(cuid()); ownerId String; provider String; configuration Json; active Boolean @default(false); createdAt DateTime @default(now()) }
model UserPreference { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); key String; value Json; updatedAt DateTime @updatedAt; @@unique([userId,key]) }
